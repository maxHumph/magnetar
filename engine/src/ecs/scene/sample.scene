#scene sample_scene;

#assets;

a_mesh crate_mesh {
  .path = "../test/res/models/crate.mg3d"
};

a_texture crate_texture {
  .path = "../test/res/textures/crate.png"
};

#entities;

entity player {

  transform = {
    .position = { 1.0, 1.0, 1.0 },
    .scale = { 1.0, 1.0, 1.0 },
    .rotation = { -30.0, 0.0, 0.0 }
  },

  c_camera = {
    .fov = 90.0,
    .near_plane = 0.1,
    .far_plane = 1000.0
  }
};

entity crate {

  transform = {
    .position = { 0.0, 0.0, -3.0 },
    .scale = { 1.0, 1.0, 1.0 },
    .rotation = { 0.0, 0.0, 0.0 }
  },

  c_mesh = {
    .asset = crate_mesh
  },

  c_material = {
    c_texture = {
      .asset = crate_texture
    }
  }
};
